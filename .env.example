# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key: server-side scripts only (seed/backup). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL used for metadata / sitemap (optional; defaults to the Netlify URL)
NEXT_PUBLIC_SITE_URL=https://cocktail-3d.netlify.app
